{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "skywatch",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "skywatch",
      "database_id": "16ab3181-7893-4a8f-8c62-84d987b92a9d"
    }
  ],
  "vpc_services": [
    {
      "binding": "VPS_AGENT",
      "service_id": "019fbd14-f4a5-7ea1-99d2-477e2d4d37ec",
      "remote": true
    }
  ],
  "vars": {
    "SKYWATCH_WORKER_NAME": "skywatch"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
